{
  "name": "MLP III - Cadastro de Clientes",
  "image": "mcr.microsoft.com/devcontainers/java:1-17",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "postCreateCommand": "cd aula && mvn -q -N wrapper:wrapper && chmod +x mvnw",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-spring-boot"]
    }
  }
}
